local function getMainCmd(alias)
    if commands[alias] then return alias end
    for main, aliases in pairs(commands) do
        if table.find(aliases, alias) then return main end
    end
    return nil
end

local function getPartialMatch(input)
    if not input or input == "" then return nil end
    for mainCmd, aliases in pairs(commands) do
        if mainCmd:sub(1, #input) == input then return mainCmd end
        for _, alias in ipairs(aliases) do
            if alias:sub(1, #input) == input then return mainCmd end
        end
    end
    return nil
end

